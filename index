                    {/* Verification Status Pill */}
                    <div
                      className={`p-3 rounded-2xl text-xs font-bold flex items-center justify-center gap-2 ${
                        faceStatusType === "error"
                          ? "bg-[#F05B69]/15 text-[#F05B69]"
                          : faceStatusType === "success"
                          ? "bg-[#39B982]/15 text-[#39B982]"
                          : "bg-[#F0ECFF] text-[#7250D5]"
                      }`}
                    >
                      <Icon
                        name={
                          faceStatusType === "error"
                            ? "alert"
                            : faceStatusType === "success"
                            ? "check"
                            : "camera"
                        }
                        className="w-4 h-4 shrink-0"
                      />
                      <span>{faceStatus}</span>
                    </div>
                  </div>
                </div>

                <div className="space-y-2 mt-3">
                  <button
                    onClick={runFaceVerification}
                    disabled={faceStatusType === "scanning" || faceStatusType === "success"}
                    className="w-full py-4 rounded-2xl bg-[#7250D5] text-white font-bold text-sm shadow-lg shadow-[#7250D5]/30 active:scale-[0.98] transition disabled:opacity-60"
                  >
                    {faceStatusType === "error"
                      ? `Retry Verification (Attempt ${faceAttempts + 1}/3)`
                      : faceStatusType === "scanning"
                      ? "Scanning Biometrics..."
                      : "Start Verification"}
                  </button>
                </div>
              </div>
            )}

            {/* ==================== 7. PAYMENT PROCESSING — MANDATORY 30 SECONDS ==================== */}
            {page === "processing" && (
              <div className="page-enter flex-1 flex flex-col justify-between pt-2">
                <div className="flex items-center justify-between">
                  <button
                    onClick={() => resetPaymentFlow("home")}
                    className="text-xs font-bold text-[#F05B69] bg-white px-3 py-1.5 rounded-xl shadow-sm"
                  >
                    Cancel & Reset
                  </button>
                  <span className="text-xs font-bold text-[#7250D5]">Step 6 of 6 • Settlement</span>
                </div>

                <div className="bg-white rounded-3xl p-6 shadow-md border border-[#B9A5FF]/30 text-center my-auto">
                  {/* Animated Ring + Live 30s Countdown */}
                  <div className="relative w-32 h-32 mx-auto mb-5 flex items-center justify-center">
                    <div className="absolute inset-0 rounded-full border-4 border-[#F0ECFF]"></div>
                    <div className="absolute inset-0 rounded-full border-4 border-[#7250D5] border-t-transparent animate-spin"></div>
                    <div className="flex flex-col items-center">
                      <span className="text-3xl font-extrabold text-[#171936]">{secondsLeft}s</span>
                      <span className="text-[10px] font-semibold uppercase text-[#7250D5]">Remaining</span>
                    </div>
                  </div>

                  <h1 className="text-xl font-extrabold text-[#171936]">Payment Processing</h1>
                  <p className="text-xs font-bold text-[#F05B69] mt-1.5">
                    Please Do Not Close This Page
                  </p>
                  <p className="text-xs text-[#171936]/60 mt-2 leading-relaxed">
                    MISSPAY is performing a mandatory 30-second multi-node risk clearance. Skipping is disabled for your protection.
                  </p>

                  {/* Transaction Summary Box */}
                  <div className="mt-5 bg-[#F0ECFF]/70 rounded-2xl p-4 text-left space-y-2 text-xs">
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Merchant</span>
                      <span className="font-bold text-[#171936]">Global Mall</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Amount</span>
                      <span className="font-extrabold text-[#7250D5]">¥ {amount}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Payment Method</span>
                      <span className="font-bold text-[#171936]">{selectedMethodObj?.name}</span>
                    </div>
                  </div>

                  {/* Progress Bar */}
                  <div className="w-full h-2 bg-[#F0ECFF] rounded-full overflow-hidden mt-5">
                    <div
                      className="h-full bg-[#7250D5] transition-all duration-1000 ease-linear"
                      style={{ width: `${((30 - secondsLeft) / 30) * 100}%` }}
                    ></div>
                  </div>
                </div>

                <div className="text-center text-[11px] text-[#171936]/50 font-medium">
                  Exiting now will cancel payment and reset all verifications.
                </div>
              </div>
            )}

            {/* ==================== 8. PAYMENT SUCCESSFUL PAGE ==================== */}
            {page === "success" && latestTx && (
              <div className="page-enter flex-1 flex flex-col justify-between pt-4">
                <div className="bg-white rounded-3xl p-6 shadow-md border border-[#B9A5FF]/30 text-center my-auto">
                  <div className="w-20 h-20 rounded-full bg-[#39B982]/15 text-[#39B982] mx-auto flex items-center justify-center mb-4">
                    <Icon name="check" className="w-10 h-10" />
                  </div>
                  <h1 className="text-2xl font-extrabold text-[#171936]">Payment Successful!</h1>
                  <p className="text-xs text-[#171936]/60 mt-1">
                    You survived the MISSPAY verification gauntlet.
                  </p>

                  <div className="text-3xl font-extrabold text-[#7250D5] my-5">
                    ¥ {latestTx.amount}
                  </div>

                  <div className="bg-[#F0ECFF]/60 rounded-2xl p-4 space-y-2.5 text-xs text-left">
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Merchant</span>
                      <span className="font-bold text-[#171936]">{latestTx.merchant}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Payment Method</span>
                      <span className="font-bold text-[#171936]">{latestTx.method}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Transaction ID</span>
                      <span className="font-mono font-bold text-[#171936]">{latestTx.id}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Timestamp</span>
                      <span className="font-semibold text-[#171936]">{latestTx.date}</span>
                    </div>
                  </div>
                </div>

                <div className="space-y-2.5">
                  <button
                    onClick={() => setPage("receipt")}
                    className="w-full py-3.5 rounded-2xl bg-[#F0ECFF] text-[#7250D5] font-bold text-sm hover:bg-[#E4DCFF] transition flex items-center justify-center gap-2"
                  >
                    <Icon name="receipt" className="w-4 h-4" />
                    <span>View Receipt</span>
                  </button>
                  <button
                    onClick={() => resetPaymentFlow("home")}
                    className="w-full py-4 rounded-2xl bg-[#7250D5] text-white font-bold text-sm shadow-lg shadow-[#7250D5]/30 transition"
                  >
                    Back to Home
                  </button>
                </div>
              </div>
            )}

            {/* ==================== 8B. DIGITAL RECEIPT MODAL PAGE ==================== */}
            {page === "receipt" && latestTx && (
              <div className="page-enter flex-1 flex flex-col justify-between pt-2">
                <div>
                  <div className="flex items-center justify-between mb-4">
                    <button
                      onClick={() => setPage("success")}
                      className="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#171936] shadow-sm"
                    >
                      <Icon name="arrowLeft" className="w-5 h-5" />
                    </button>
                    <span className="text-sm font-bold text-[#171936]">Official Voucher</span>
                    <div className="w-9"></div>
                  </div>

                  <div className="bg-white rounded-3xl p-6 shadow-md border border-[#B9A5FF]/40 relative">
                    <div className="flex items-center justify-between border-b border-dashed border-slate-200 pb-4 mb-4">
                      <MisspayLogo size="md" />
                      <span className="text-[11px] font-bold px-2.5 py-1 rounded-full bg-[#39B982]/15 text-[#39B982]">
                        SETTLED
                      </span>
                    </div>

                    <div className="text-center py-2">
                      <p className="text-xs text-[#171936]/60">Total Paid to {latestTx.merchant}</p>
                      <p className="text-3xl font-extrabold text-[#171936] mt-1">¥ {latestTx.amount}</p>
                    </div>

                    <div className="border-t border-dashed border-slate-200 pt-4 mt-4 space-y-3 text-xs">
                      <div className="flex justify-between">
                        <span className="text-[#171936]/60">Transaction No.</span>
                        <span className="font-mono font-bold">{latestTx.id}</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-[#171936]/60">Funding Channel</span>
                        <span className="font-bold">{latestTx.method}</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-[#171936]/60">Security Clearance</span>
                        <span className="font-bold text-[#7250D5]">PIN + 3x CAPTCHA + Biometric</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-[#171936]/60">Date & Time</span>
                        <span className="font-semibold">{latestTx.date}</span>
                      </div>
                    </div>
                  </div>
                </div>

                <button
                  onClick={() => resetPaymentFlow("home")}
                  className="w-full py-4 rounded-2xl bg-[#7250D5] text-white font-bold text-sm shadow-lg shadow-[#7250D5]/30"
                >
                  Back to Home
                </button>
              </div>
            )}

            {/* ==================== 9. TRANSACTION HISTORY PAGE ==================== */}
            {page === "history" && (
              <div className="page-enter flex-1 flex flex-col pt-2">
                <div className="flex items-center justify-between mb-5">
                  <button
                    onClick={() => setPage("home")}
                    className="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#171936] shadow-sm"
                  >
                    <Icon name="arrowLeft" className="w-5 h-5" />
                  </button>
                  <span className="text-base font-extrabold text-[#171936]">Transaction History</span>
                  <div className="w-9"></div>
                </div>

                <div className="space-y-3 flex-1 overflow-y-auto no-scrollbar">
                  {transactions.map((tx) => (
                    <div
                      key={tx.id}
                      className="bg-white rounded-2xl p-4 shadow-sm border border-[#B9A5FF]/30 flex items-center justify-between"
                    >
                      <div>
                        <div className="flex items-center gap-2">
                          <span className="font-extrabold text-sm text-[#171936]">{tx.merchant}</span>
                          <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#39B982]/15 text-[#39B982]">
                            {tx.status}
                          </span>
                        </div>
                        <p className="text-xs text-[#171936]/60 mt-1">
                          {tx.method} • {tx.date}
                        </p>
                        <p className="text-[10px] font-mono text-[#171936]/40 mt-0.5">{tx.id}</p>
                      </div>
                      <div className="text-right">
                        <span className="text-base font-extrabold text-[#7250D5]">-¥{tx.amount}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* ==================== 10. PROFILE PAGE ==================== */}
            {page === "profile" && (
              <div className="page-enter flex-1 flex flex-col justify-between pt-2">
                <div>
                  <div className="flex items-center justify-between mb-5">
                    <button
                      onClick={() => setPage("home")}
                      className="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#171936] shadow-sm"
                    >
                      <Icon name="arrowLeft" className="w-5 h-5" />
                    </button>
                    <span className="text-base font-extrabold text-[#171936]">Account & Rules</span>
                    <div className="w-9"></div>
                  </div>

                  <div className="bg-white rounded-3xl p-5 shadow-sm border border-[#B9A5FF]/30 text-center mb-4">
                    <div className="w-16 h-16 rounded-full bg-[#7250D5] text-white text-2xl font-extrabold mx-auto flex items-center justify-center mb-3">
                      M
                    </div>
                    <h2 className="font-extrabold text-base text-[#171936]">MISSPAY Demo User</h2>
                    <p className="text-xs text-[#7250D5] font-semibold mt-0.5">
                      "Your Money. Our Rules."
                    </p>
                  </div>

                  <div className="bg-white rounded-2xl p-4 shadow-sm border border-[#B9A5FF]/30 space-y-3 text-xs">
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Default Test PIN</span>
                      <span className="font-mono font-bold text-[#7250D5]">123456</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">CAPTCHA Challenge</span>
                      <span className="font-bold">3 Mandatory Rounds</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Biometric Sensor</span>
                      <span className="font-bold text-[#39B982]">WebRTC Live Camera</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#171936]/60">Settlement Delay</span>
                      <span className="font-bold text-[#F05B69]">30 Seconds Fixed</span>
                    </div>
                  </div>
                </div>

                <button
                  onClick={() => {
                    localStorage.removeItem("misspay_transactions_v1");
                    setTransactions(INITIAL_HISTORY);
                    setPage("home");
                  }}
                  className="w-full py-3.5 rounded-2xl bg-white text-[#F05B69] border border-[#F05B69]/30 font-bold text-xs"
                >
                  Reset Demo Transaction History
                </button>
              </div>
            )}
          </div>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById("root"));
    root.render(<App />);
  </script>
</body>
</html>
